#pragma kernel ExtractSource
Texture2D<float4> _EmissionSourceAtlas;
SamplerState sampler_PointClamp;
RWStructuredBuffer<float4> _EmissionSourcePixels;
int2 _EmissionSourceOrigin;
int2 _EmissionSourceSize;
float2 _EmissionAtlasInverseSize;

[numthreads(8, 8, 1)]
void ExtractSource(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_EmissionSourceSize)) { return; }
    float2 uv = (float2(_EmissionSourceOrigin + (int2)id.xy) + 0.5) * _EmissionAtlasInverseSize;
    // The source atlas sRGB view decodes once. Buffer indexing follows source
    // UV coordinates, independently of render-target row conventions.
    _EmissionSourcePixels[id.y * _EmissionSourceSize.x + id.x] =
        _EmissionSourceAtlas.SampleLevel(sampler_PointClamp, uv, 0);
}
