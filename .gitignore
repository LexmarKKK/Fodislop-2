# Вывод сборки, кэши и служебные каталоги. Привязаны к корню намеренно:
# непривязанные [Dd]ebug/ съедали Packages/.../Shaders/Debug и
# ShaderLibrary/Debug (URP ломался на свежем клоне), а x86/ и [Aa][Rr][Mm]64/ —
# нативные библиотеки FMOD под Packages/.
/[Dd]ebug/
/[Dd]ebugPublic/
/[Dd]ebugPS/
/[Rr]elease/
/[Rr]eleases/
/[Rr]eleasePS/
/[Bb]in/
/[Oo]bj/
/[Oo]ut/
/[Bb]uild/
/[Bb]uilds/
/[Ll]og/
/[Ll]ogs/
/[Tt]emp/
/[Ll]ibrary/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/
/[Tt]est[Rr]esult*/
/[Aa][Rr][Mm]/
/[Aa][Rr][Mm]64/
/[Xx]64/
/[Xx]86/
/[Ww][Ii][Nn]32/
.vs/
.idea/
.gradle/
ExportedObj/
node_modules/
__pycache__/
*.pyc
# Без якоря (core.ignorecase=true) это правило скрывало исходники в Assets/**/Artifacts/
/artifacts/
BenchmarkDotNet.Artifacts/
# Вывод standalone .NET-инструментов; нативные бинарники пакетов остаются видны.
/tools/**/bin/
/tools/**/obj/

